// Port of libretro slang-shaders crt/shaders/crt-aperture.slang (preset crt/crt-aperture.slangp:
// one pass, filter_linear0 = false, wrap_mode default = clamp_to_border).
//
/*
    CRT Shader by EasyMode
    License: GPL
*/
//
// Port notes: default #pragma parameters baked in. The GLSL mat3x3/mat4x4 helpers are
// expanded into explicit column sums (GLSL column-major semantics: m[i] is the i-th
// constructor argument; mat4(c1,c1,c2,c2) * coef = c1*coef.x + c1*coef.y + c2*coef.z +
// c2*coef.w). GLSL mod() is reproduced as x - y*floor(x/y). aperture_tex emulates
// libretro's default clamp_to_border sampler (black outside the frame) since the engine
// sampler repeats.
#pragma once
#include "crt_common.slangh"

static const float aperture_SHARPNESS_IMAGE   = 1.0;
static const float aperture_SHARPNESS_EDGES   = 3.0;
static const float aperture_GLOW_WIDTH        = 0.5;
static const float aperture_GLOW_HEIGHT       = 0.5;
static const float aperture_GLOW_HALATION     = 0.1;
static const float aperture_GLOW_DIFFUSION    = 0.05;
static const float aperture_MASK_COLORS       = 2.0;
static const float aperture_MASK_STRENGTH     = 0.3;
static const float aperture_MASK_SIZE         = 1.0;
static const float aperture_SCANLINE_SIZE_MIN = 0.5;
static const float aperture_SCANLINE_SIZE_MAX = 1.5;
static const float aperture_SCANLINE_SHAPE    = 2.5;
static const float aperture_SCANLINE_OFFSET   = 1.0;
static const float aperture_GAMMA_INPUT       = 2.4;
static const float aperture_GAMMA_OUTPUT      = 2.4;
static const float aperture_BRIGHTNESS        = 1.5;

static const float aperture_PI = 3.141592653589;

float aperture_mod(float x, float y) { return x - y * floor(x / y); }

// FIX(c)
vec4 aperture_FIX(vec4 c) { return max(abs(c), vec4(1e-5, 1e-5, 1e-5, 1e-5)); }

// texture(Source, uv) with nearest filtering and a black border outside [0,1).
vec4 aperture_tex(vec2 uv)
{
    if (uv.x < 0.0 || uv.y < 0.0 || uv.x >= 1.0 || uv.y >= 1.0) return vec4(0.0, 0.0, 0.0, 0.0);
    return crt_tex_nearest(uv);
}

// TEX2D(c)
vec3 aperture_TEX2D(vec2 co)
{
    return pow(aperture_tex(co).rgb, vec3(aperture_GAMMA_INPUT, aperture_GAMMA_INPUT, aperture_GAMMA_INPUT));
}

// blur(mat3(m0, m1, m2), dist, rad)
vec3 aperture_blur(vec3 m0, vec3 m1, vec3 m2, float dist, float rad)
{
    vec3 x = vec3(dist - 1.0, dist, dist + 1.0) / rad;
    vec3 w = exp2(x * x * -1.0);

    return (m0 * w.x + m1 * w.y + m2 * w.z) / (w.x + w.y + w.z);
}

// blur(get_color_matrix(co, dx), dist, rad)
vec3 aperture_blur_line(vec2 co, vec2 dx, float dist, float rad)
{
    return aperture_blur(aperture_TEX2D(co - dx), aperture_TEX2D(co), aperture_TEX2D(co + dx), dist, rad);
}

vec3 aperture_filter_gaussian(vec2 co, vec2 tex_size)
{
    vec2 dx = vec2(1.0 / tex_size.x, 0.0);
    vec2 dy = vec2(0.0, 1.0 / tex_size.y);
    vec2 pix_co = co * tex_size;
    vec2 tex_co = (floor(pix_co) + 0.5) / tex_size;
    vec2 dist = (fract(pix_co) - 0.5) * -1.0;

    vec3 column0 = aperture_blur_line(tex_co - dy, dx, dist.x, aperture_GLOW_WIDTH);
    vec3 column1 = aperture_blur_line(tex_co,      dx, dist.x, aperture_GLOW_WIDTH);
    vec3 column2 = aperture_blur_line(tex_co + dy, dx, dist.x, aperture_GLOW_WIDTH);

    return aperture_blur(column0, column1, column2, dist.y, aperture_GLOW_HEIGHT);
}

vec3 aperture_filter_lanczos(vec2 co, vec2 tex_size, float sharp)
{
    tex_size.x *= sharp;

    vec2 dx = vec2(1.0 / tex_size.x, 0.0);
    vec2 pix_co = co * tex_size - vec2(0.5, 0.0);
    vec2 tex_co = (floor(pix_co) + vec2(0.5, 0.001)) / tex_size;
    vec2 dist = fract(pix_co);
    vec4 coef = aperture_PI * vec4(dist.x + 1.0, dist.x, dist.x - 1.0, dist.x - 2.0);

    coef = aperture_FIX(coef);
    coef = 2.0 * sin(coef) * sin(coef / 2.0) / (coef * coef);
    coef /= dot(coef, vec4(1.0, 1.0, 1.0, 1.0));

    vec4 col1 = vec4(aperture_TEX2D(tex_co), 1.0);
    vec4 col2 = vec4(aperture_TEX2D(tex_co + dx), 1.0);

    // (mat4x4(col1, col1, col2, col2) * coef).rgb
    return (col1 * coef.x + col1 * coef.y + col2 * coef.z + col2 * coef.w).rgb;
}

vec3 aperture_get_scanline_weight(float x, vec3 col)
{
    float e = 1.0 / aperture_SCANLINE_SHAPE;
    vec3 beam = mix(vec3(aperture_SCANLINE_SIZE_MIN, aperture_SCANLINE_SIZE_MIN, aperture_SCANLINE_SIZE_MIN),
                    vec3(aperture_SCANLINE_SIZE_MAX, aperture_SCANLINE_SIZE_MAX, aperture_SCANLINE_SIZE_MAX),
                    pow(col, vec3(e, e, e)));
    vec3 x_mul = 2.0 / beam;
    vec3 x_offset = x_mul * 0.5;

    return smoothstep(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0), 1.0 - abs(x * x_mul - x_offset)) * x_offset;
}

vec3 aperture_get_mask_weight(CrtIn c, float x)
{
    float i = aperture_mod(floor(x * c.OutputSize.x * c.SourceSize.x / (c.SourceSize.x * aperture_MASK_SIZE)), aperture_MASK_COLORS);

    if (i == 0.0) return mix(vec3(1.0, 0.0, 1.0), vec3(1.0, 0.0, 0.0), aperture_MASK_COLORS - 2.0);
    else if (i == 1.0) return vec3(0.0, 1.0, 0.0);
    else return vec3(0.0, 0.0, 1.0);
}

vec3 crt_aperture(CrtIn c)
{
    float scale = floor(c.OutputSize.y * c.SourceSize.w);
    float offset = 1.0 / scale * 0.5;

    if (aperture_mod(scale, 2.0) != 0.0) offset = 0.0;

    vec2 co = (c.uv * c.SourceSize.xy - vec2(0.0, offset * aperture_SCANLINE_OFFSET)) * c.SourceSize.zw;
    vec3 col_glow = aperture_filter_gaussian(co, c.SourceSize.xy);
    vec3 col_soft = aperture_filter_lanczos(co, c.SourceSize.xy, aperture_SHARPNESS_IMAGE);
    vec3 col_sharp = aperture_filter_lanczos(co, c.SourceSize.xy, aperture_SHARPNESS_EDGES);
    vec3 col = sqrt(col_sharp * col_soft);

    col *= aperture_get_scanline_weight(fract(co.y * c.SourceSize.y), col_soft);
    col_glow = clamp(col_glow - col, 0.0, 1.0);
    col += col_glow * col_glow * aperture_GLOW_HALATION;
    col = mix(col, col * aperture_get_mask_weight(c, c.uv.x) * aperture_MASK_COLORS, aperture_MASK_STRENGTH);
    col += col_glow * aperture_GLOW_DIFFUSION;
    float g = 1.0 / aperture_GAMMA_OUTPUT;
    col = pow(col * aperture_BRIGHTNESS, vec3(g, g, g));
    return col;
}
