#pragma once
#include "crt_common.slangh"

// #pragma parameter defaults.
// 0.5 = the spot stays inside the original pixel
// 1.0 = the spot bleeds up to the center of next pixel
static const float caligari_SPOT_WIDTH  = 0.9;
static const float caligari_SPOT_HEIGHT = 0.65;
// Used to counteract the desaturation effect of weighting.
static const float caligari_COLOR_BOOST = 1.45;
// Constants used with gamma correction.
static const float caligari_InputGamma  = 2.4;
static const float caligari_OutputGamma = 2.2;

// #define GAMMA_IN(color)  pow(color,vec4(params.InputGamma))
vec4 caligari_GAMMA_IN(vec4 color)  { return pow(color, vec4(caligari_InputGamma)); }
// #define GAMMA_OUT(color) pow(color, vec4(1.0 / params.OutputGamma))
vec4 caligari_GAMMA_OUT(vec4 color) { return pow(color, vec4(1.0 / caligari_OutputGamma)); }
// #define TEX2D(coords) GAMMA_IN( texture(Source, coords) )
vec4 caligari_TEX2D(vec2 coords)    { return caligari_GAMMA_IN(crt_tex_nearest(coords)); }

// Macro for weights computing:
// #define WEIGHT(w) if(w>1.0) w=1.0; w = 1.0 - w * w; w = w * w;
void caligari_WEIGHT(inout float w)
{
    if(w>1.0) w=1.0;
    w = 1.0 - w * w;
    w = w * w;
}

vec3 crt_caligari(CrtIn c)
{
    // Vertex shader.
    vec2 vTexCoord = c.uv;
    vec2 onex = vec2(c.SourceSize.z, 0.0);
    vec2 oney = vec2(0.0, c.SourceSize.w);

    vec2 coords = ( vTexCoord * c.SourceSize.xy );
    vec2 pixel_center = floor( coords ) + vec2(0.5, 0.5);
    vec2 texture_coords = pixel_center * c.SourceSize.zw;

    vec4 color = caligari_TEX2D( texture_coords );

    float dx = coords.x - pixel_center.x;

    float h_weight_00 = dx / caligari_SPOT_WIDTH;
    caligari_WEIGHT( h_weight_00 );

    color *= vec4( h_weight_00, h_weight_00, h_weight_00, h_weight_00  );

    // get closest horizontal neighbour to blend
    vec2 coords01;
    if (dx>0.0) {
       coords01 = onex;
       dx = 1.0 - dx;
    } else {
       coords01 = -onex;
       dx = 1.0 + dx;
    }
    vec4 colorNB = caligari_TEX2D( texture_coords + coords01 );

    float h_weight_01 = dx / caligari_SPOT_WIDTH;
    caligari_WEIGHT( h_weight_01 );

    color = color + colorNB * vec4( h_weight_01 );

    //////////////////////////////////////////////////////
    // Vertical Blending
    float dy = coords.y - pixel_center.y;
    float v_weight_00 = dy / caligari_SPOT_HEIGHT;
    caligari_WEIGHT( v_weight_00 );
    color *= vec4( v_weight_00 );

    // get closest vertical neighbour to blend
    vec2 coords10;
    if (dy>0.0) {
       coords10 = oney;
       dy = 1.0 - dy;
    } else {
       coords10 = -oney;
       dy = 1.0 + dy;
    }
    colorNB = caligari_TEX2D( texture_coords + coords10 );

    float v_weight_10 = dy / caligari_SPOT_HEIGHT;
    caligari_WEIGHT( v_weight_10 );

    color = color + colorNB * vec4( v_weight_10 * h_weight_00, v_weight_10 * h_weight_00, v_weight_10 * h_weight_00, v_weight_10 * h_weight_00 );

    colorNB = caligari_TEX2D(  texture_coords + coords01 + coords10 );

    color = color + colorNB * vec4( v_weight_10 * h_weight_01, v_weight_10 * h_weight_01, v_weight_10 * h_weight_01, v_weight_10 * h_weight_01 );

    color *= vec4( caligari_COLOR_BOOST );

    return clamp( caligari_GAMMA_OUT(color), 0.0, 1.0 ).rgb;
}
