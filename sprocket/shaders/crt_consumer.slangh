*/
#pragma once
#include "crt_common.slangh"

// #pragma parameter defaults
static const float consumer_PRE_SCALE    = 1.5;
static const float consumer_blurx        = 0.25;
static const float consumer_blury        = -0.1;
static const float consumer_warpx        = 0.03;
static const float consumer_warpy        = 0.04;
static const float consumer_corner       = 0.03;
static const float consumer_smoothness   = 400.0;
static const float consumer_inter        = 1.0;
static const float consumer_Downscale    = 2.0;
static const float consumer_scanlow      = 6.0;
static const float consumer_scanhigh     = 8.0;
static const float consumer_beamlow      = 1.45;
static const float consumer_beamhigh     = 1.05;
static const float consumer_preserve     = 0.98;
static const float consumer_brightboost1 = 1.25;
static const float consumer_brightboost2 = 1.0;
static const float consumer_glow         = 3.0;
static const float consumer_quality      = 1.0;
static const float consumer_glow_str     = 0.3;
static const float consumer_nois         = 0.0;
static const float consumer_postbr       = 1.0;
static const float consumer_palette_fix  = 0.0;
static const float consumer_Shadowmask   = 0.0;
static const float consumer_masksize     = 1.0;
static const float consumer_MaskDark     = 0.2;
static const float consumer_MaskLight    = 1.5;
static const float consumer_slotmask     = 0.0;
static const float consumer_slotwidth    = 2.0;
static const float consumer_double_slot  = 1.0;
static const float consumer_slotms       = 1.0;
static const float consumer_GAMMA_OUT    = 2.25;
static const float consumer_sat          = 1.0;
static const float consumer_contrast     = 1.0;
static const float consumer_WP           = 0.0;
static const float consumer_rg           = 0.0;
static const float consumer_rb           = 0.0;
static const float consumer_gr           = 0.0;
static const float consumer_gb           = 0.0;
static const float consumer_br           = 0.0;
static const float consumer_bg           = 0.0;
static const float consumer_vignette     = 0.0;
static const float consumer_vpower       = 0.15;
static const float consumer_vstr         = 40.0;
static const float consumer_alloff       = 0.0;

// GLSL mod(): x - y * floor(x / y)
float consumer_mod(float x, float y) { return x - y * floor(x / y); }

// GLSL `mat3(c0, c1, c2) * v` (column-major), written out to avoid matrix-convention pitfalls.
vec3 consumer_mul3(vec3 c0, vec3 c1, vec3 c2, vec3 v) { return c0 * v.x + c1 * v.y + c2 * v.z; }

vec2 consumer_Warp(vec2 pos)
{
    pos  = pos * 2.0 - 1.0;
    pos *= vec2(1.0 + (pos.y * pos.y) * consumer_warpx, 1.0 + (pos.x * pos.x) * consumer_warpy);
    return pos * 0.5 + 0.5;
}

float consumer_sw(float y, float l)
{
    float beam = mix(consumer_scanlow, consumer_scanhigh, y);
    float scan = mix(consumer_beamlow, consumer_beamhigh, l);
    float ex = y * scan;
    return exp2(-beam * ex * ex);
}

vec3 consumer_mask(vec2 x, vec3 col, float l)
{
    x = floor(x / consumer_masksize);

    if (consumer_Shadowmask == 0.0)
    {
        float m = fract(x.x * 0.4999);
        if (m < 0.4999) return vec3(1.0,                consumer_MaskDark, 1.0);
        else            return vec3(consumer_MaskDark,  1.0,               consumer_MaskDark);
    }

    else if (consumer_Shadowmask == 1.0)
    {
        vec3 Mask = vec3(consumer_MaskDark, consumer_MaskDark, consumer_MaskDark);
        float line = consumer_MaskLight;
        float odd  = 0.0;

        if (fract(x.x / 6.0) < 0.5) odd = 1.0;
        if (fract((x.y + odd) / 2.0) < 0.5) line = consumer_MaskDark;

        float m = fract(x.x / 3.0);
        if      (m < 0.333) Mask.b = consumer_MaskLight;
        else if (m < 0.666) Mask.g = consumer_MaskLight;
        else                Mask.r = consumer_MaskLight;

        Mask *= line;
        return Mask;
    }

    else if (consumer_Shadowmask == 2.0)
    {
        float m = fract(x.x * 0.3333);
        if (m < 0.3333) return vec3(consumer_MaskDark,  consumer_MaskDark,  consumer_MaskLight);
        if (m < 0.6666) return vec3(consumer_MaskDark,  consumer_MaskLight, consumer_MaskDark);
        else            return vec3(consumer_MaskLight, consumer_MaskDark,  consumer_MaskDark);
    }

    if (consumer_Shadowmask == 3.0)
    {
        float m = fract(x.x * 0.5);
        if (m < 0.5) return vec3(1.0, 1.0, 1.0);
        else         return vec3(consumer_MaskDark, consumer_MaskDark, consumer_MaskDark);
    }

    else if (consumer_Shadowmask == 4.0)
    {
        vec3 Mask = vec3(col.rgb);
        float line = consumer_MaskLight;
        float odd  = 0.0;

        if (fract(x.x / 4.0) < 0.5) odd = 1.0;
        if (fract((x.y + odd) / 2.0) < 0.5) line = consumer_MaskDark;

        float m = fract(x.x / 2.0);
        if (m < 0.5) { Mask.r = 1.0; Mask.b = 1.0; }
        else Mask.g = 1.0;

        Mask *= line;
        return Mask;
    }

    else if (consumer_Shadowmask == 5.0)
    {
        vec3 Mask = vec3(1.0, 1.0, 1.0);

        if (fract(x.x / 4.0) < 0.5)
        {
            if (fract(x.y / 3.0) < 0.666)
            {
                if (fract(x.x / 2.0) < 0.5) Mask = vec3(1.0,               consumer_MaskDark, 1.0);
                else                        Mask = vec3(consumer_MaskDark, 1.0,               consumer_MaskDark);
            }
            else Mask *= l;
        }
        else if (fract(x.x / 4.0) >= 0.5)
        {
            if (fract(x.y / 3.0) > 0.333)
            {
                if (fract(x.x / 2.0) < 0.5) Mask = vec3(1.0,               consumer_MaskDark, 1.0);
                else                        Mask = vec3(consumer_MaskDark, 1.0,               consumer_MaskDark);
            }
            else Mask *= l;
        }

        return Mask;
    }

    else if (consumer_Shadowmask == 6.0)
    {
        vec3 Mask = vec3(consumer_MaskDark, consumer_MaskDark, consumer_MaskDark);
        if (fract(x.x / 6.0) < 0.5)
        {
            if (fract(x.y / 4.0) < 0.75)
            {
                if      (fract(x.x / 3.0) < 0.3333) Mask.r = consumer_MaskLight;
                else if (fract(x.x / 3.0) < 0.6666) Mask.g = consumer_MaskLight;
                else                                Mask.b = consumer_MaskLight;
            }
            // else: original has the no-op statement `Mask * l * 0.9;`
        }
        else if (fract(x.x / 6.0) >= 0.5)
        {
            if (fract(x.y / 4.0) >= 0.5 || fract(x.y / 4.0) < 0.25)
            {
                if      (fract(x.x / 3.0) < 0.3333) Mask.r = consumer_MaskLight;
                else if (fract(x.x / 3.0) < 0.6666) Mask.g = consumer_MaskLight;
                else                                Mask.b = consumer_MaskLight;
            }
            // else: original has the no-op statement `Mask * l * 0.9;`
        }
        return Mask;
    }

    else if (consumer_Shadowmask == 7.0)
    {
        float m = fract(x.x * 0.3333);

        if (m < 0.3333) return vec3(consumer_MaskDark,          consumer_MaskLight,         consumer_MaskLight * col.b); //Cyan
        if (m < 0.6666) return vec3(consumer_MaskLight * col.r, consumer_MaskDark,          consumer_MaskLight);         //Magenta
        else            return vec3(consumer_MaskLight,         consumer_MaskLight * col.g, consumer_MaskDark);          //Yellow
    }

    else if (consumer_Shadowmask == 8.0)
    {
        vec3 Mask = vec3(consumer_MaskDark, consumer_MaskDark, consumer_MaskDark);

        float bright = consumer_MaskLight;
        float left   = 0.0;
        if (fract(x.x / 6.0) < 0.5) left = 1.0;

        float m = fract(x.x / 3.0);
        if      (m < 0.333) Mask.b = 0.9;
        else if (m < 0.666) Mask.g = 0.9;
        else                Mask.r = 0.9;

        if ((consumer_mod(x.y, 2.0) == 1.0 && left == 1.0) || (consumer_mod(x.y, 2.0) == 0.0 && left == 0.0))
            Mask *= bright;

        return Mask;
    }

    else return vec3(1.0, 1.0, 1.0);
}

float consumer_SlotMask(vec2 pos, vec3 c)
{
    if (consumer_slotmask == 0.0) return 1.0;

    pos = floor(pos / consumer_slotms);
    float mx = pow(max(max(c.r, c.g), c.b), 1.33);
    float mlen = consumer_slotwidth * 2.0;
    float px = fract(pos.x / mlen);
    float py = floor(fract(pos.y / (2.0 * consumer_double_slot)) * 2.0 * consumer_double_slot);
    float slot_dark = mix(1.0 - consumer_slotmask, 1.0 - 0.80 * consumer_slotmask, mx);
    float slot = 1.0 + 0.7 * consumer_slotmask * (1.0 - mx);

    if      (py == 0.0                  && px <  0.5) slot = slot_dark;
    else if (py == consumer_double_slot && px >= 0.5) slot = slot_dark;

    return slot;
}

// contrastMatrix(contrast) * v, written out: the GLSL mat4 has columns
// (C,0,0,0), (0,C,0,0), (0,0,C,0), (t,t,t,1).
vec4 consumer_contrast_apply(vec4 v)
{
    float t = (1.0 - consumer_contrast) / 2.0;
    return vec4(consumer_contrast * v.xyz + t * v.w, v.w);
}

// vign(l) returns diag(vig); `res.rgb *= vign(lum)` scales rgb by vig.
float consumer_vign(vec2 vTexCoord)
{
    vec2 vpos = vTexCoord;
    vpos *= 1.0 - vpos.xy;

    float vig = vpos.x * vpos.y * consumer_vstr;
    vig = min(pow(vig, consumer_vpower), 1.0);
    if (consumer_vignette == 0.0) vig = 1.0;
    return vig;
}

vec3 consumer_saturation(vec3 textureColor)
{
    float luminance = length(textureColor.rgb) * 0.5775;

    vec3 luminanceWeighting = vec3(0.4, 0.5, 0.1);
    if (luminance < 0.5) luminanceWeighting.rgb = (luminanceWeighting.rgb * luminanceWeighting.rgb)
                                                + (luminanceWeighting.rgb * luminanceWeighting.rgb);

    luminance = dot(textureColor.rgb, luminanceWeighting);
    vec3 greyScaleColor = vec3(luminance, luminance, luminance);

    vec3 res = vec3(mix(greyScaleColor, textureColor.rgb, consumer_sat));
    return res;
}

vec3 consumer_glow0(CrtIn c, vec2 texcoord, vec3 col)
{
    // the more quality, the smaller the offset and better quality, less visible glow too
    vec2 size = c.SourceSize.zw / consumer_quality;

    vec3 c01;
    vec3 sum = vec3(0.0);

    // glow = pixels per axis, the more the slower!
    for (float x = -consumer_glow; x <= consumer_glow; x = x + 1.0)
    {
        // multiply texture, the more far away the less pronounced
        float factor = 1.0 / consumer_glow;
        for (float y = -consumer_glow; y <= consumer_glow; y = y + 1.0)
        {
            vec2 offset = vec2(x, y) * size;

            c01 = crt_tex(texcoord + offset).rgb * factor; c01 = c01 * c01;

            sum += c01;
        }
    }

    return (consumer_glow_str * sum / (consumer_glow * consumer_glow));
}

float consumer_noise(CrtIn c, vec2 co)
{
    float iTimer = float(c.FrameCount) / 60.0;
    return fract(sin(iTimer * dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
}

float consumer_corner0(CrtIn c, vec2 coord)
{
    coord = (coord - vec2(0.5, 0.5)) * 1.0 + vec2(0.5, 0.5);
    coord = min(coord, vec2(1.0, 1.0) - coord) * vec2(1.0, c.SourceSize.y / c.SourceSize.x);

    vec2 cdist = vec2(consumer_corner, consumer_corner);
    coord = (cdist - min(coord, cdist));
    float dist = sqrt(dot(coord, coord));

    return clamp((cdist.x - dist) * consumer_smoothness, 0.0, 1.0);
}

// Colour-temperature matrices, as the columns of the original GLSL mat3 constants.
vec3 consumer_D65_to_XYZ(vec3 v) { return consumer_mul3(vec3( 0.4306190,  0.2220379,  0.0201853), vec3( 0.3415419,  0.7066384,  0.1295504), vec3( 0.1783091,  0.0713236,  0.9390944), v); }
vec3 consumer_XYZ_to_D65(vec3 v) { return consumer_mul3(vec3( 3.0628971, -0.9692660,  0.0678775), vec3(-1.3931791,  1.8760108, -0.2288548), vec3(-0.4757517,  0.0415560,  1.0693490), v); }
vec3 consumer_D50_to_XYZ(vec3 v) { return consumer_mul3(vec3( 0.4552773,  0.2323025,  0.0145457), vec3( 0.3675500,  0.7077956,  0.1049154), vec3( 0.1413926,  0.0599019,  0.7057489), v); }
vec3 consumer_XYZ_to_D50(vec3 v) { return consumer_mul3(vec3( 2.9603944, -0.9787684,  0.0844874), vec3(-1.4678519,  1.9161415, -0.2545973), vec3(-0.4685105,  0.0334540,  1.4216174), v); }

vec3 crt_consumer(CrtIn c)
{
    vec2 vTexCoord = c.uv * 1.0001; // vertex shader
    float iTime = float(c.FrameCount) / 2.0;

    vec2 pos = consumer_Warp(vTexCoord.xy);
    vec2 tex_size = c.SourceSize.xy;

    vec2 pC4 = (pos + 0.5 / tex_size);
    vec2 fp = fract(pos * tex_size);
    if (consumer_inter < 0.5 && tex_size.y > 400.0) { fp.y = fract(pos.y * tex_size.y * 1.0 / consumer_Downscale); }

    vec4 res = vec4(1.0);

    if (consumer_alloff == 1.0)
        res = crt_tex(pC4);
    else
    {
        vec2 texel = pos * tex_size;
        vec2 texel_floored = floor(texel);

        float scale = consumer_PRE_SCALE;
        float region_range = 0.5 - 0.5 / scale;

        // Figure out where in the texel to sample to get correct pre-scaled bilinear.
        // Uses the hardware bilinear interpolator to avoid having to sample 4 times manually.
        vec2 center_dist = fp - 0.5;

        vec2 fpp = (center_dist - clamp(center_dist, -region_range, region_range)) * scale + 0.5;

        vec2 mod_texel = texel_floored + fpp;
        vec2 coords = mod_texel / c.SourceSize.xy;

        vec3 sample1 = crt_tex(vec2(coords.x + consumer_blurx * c.SourceSize.z, coords.y - consumer_blury * c.SourceSize.w)).rgb;
        vec3 sample2 = crt_tex(coords).rgb;
        vec3 sample3 = crt_tex(vec2(coords.x - consumer_blurx * c.SourceSize.z, coords.y + consumer_blury * c.SourceSize.w)).rgb;

        vec3 color = vec3(sample1.r * 0.5  + sample2.r * 0.5,
                          sample1.g * 0.25 + sample2.g * 0.5 + sample3.g * 0.25,
                          sample2.b * 0.5  + sample3.b * 0.5);
        if (consumer_palette_fix != 0.0)
        {
            if (consumer_palette_fix == 1.0) color = color * 1.0667;
            else if (consumer_palette_fix == 2.0) color = color * 2.0;
        }

        //COLOR TEMPERATURE FROM GUEST.R-DR.VENOM
        if (consumer_WP != 0.0)
        {
            vec3 warmer = consumer_D50_to_XYZ(color);
            warmer = consumer_XYZ_to_D65(warmer);

            vec3 cooler = consumer_D65_to_XYZ(color);
            cooler = consumer_XYZ_to_D50(cooler);

            float m = abs(consumer_WP) / 100.0;
            vec3 comp = (consumer_WP < 0.0) ? cooler : warmer;
            comp = clamp(comp, 0.0, 1.0);

            color = vec3(mix(color, comp, m));
        }

        // hue = mat3(1, rg, rb,  gr, 1, gb,  br, bg, 1) (columns); color = hue * color
        color = consumer_mul3(vec3(1.0, consumer_rg, consumer_rb),   // red tint
                              vec3(consumer_gr, 1.0, consumer_gb),   // green tint
                              vec3(consumer_br, consumer_bg, 1.0),   // blue tint
                              color);

        color = (2.0 * pow(color, vec3(2.8))) - pow(color, vec3(3.6));

        float lum = color.r * 0.3 + color.g * 0.6 + color.b * 0.1;

        float f = fract(fp.y - 0.5);

        if (consumer_inter > 0.5 && tex_size.y > 400.0) color = color;
        else
        { color = color * consumer_sw(f, lum) + color * consumer_sw(1.0 - f, lum); }

        float lum1 = color.r * 0.3 + color.g * 0.6 + color.b * 0.1;

        color *= mix(consumer_mask((vTexCoord * c.OutputSize.xy), color, lum1), vec3(1.0), lum1 * consumer_preserve);

        if (consumer_slotmask != 0.0) color *= consumer_SlotMask((vTexCoord * c.OutputSize.xy) * 1.0001, color);

        color *= mix(consumer_brightboost1, consumer_brightboost2, max(max(color.r, color.g), color.b));

        color = pow(color, vec3(1.0 / consumer_GAMMA_OUT));
        if (consumer_glow_str != 0.0) color += consumer_glow0(c, coords, color);

        if (consumer_sat    != 1.0) color  = consumer_saturation(color);
        if (consumer_corner != 0.0) color *= consumer_corner0(c, pC4);
        if (consumer_nois   != 0.0) color *= 1.0 + consumer_noise(c, coords * 2.0) / consumer_nois;

        color *= mix(1.0, consumer_postbr, lum);
        res = vec4(color, 1.0);
        if (consumer_contrast != 1.0) res = consumer_contrast_apply(res);
        if (consumer_inter > 0.5 && c.SourceSize.y > 400.0 && fract(iTime) < 0.5) res = res * 0.95;
        res.rgb *= consumer_vign(vTexCoord);
    }

    return res.rgb;
}
