#pragma once
#include "crt_common.slangh"

// #pragma parameter defaults
static const float hyllian_MASK_INTENSITY = 0.5;
static const float hyllian_InputGamma     = 2.4;
static const float hyllian_OutputGamma    = 2.2;
static const float hyllian_BRIGHTBOOST    = 1.5;
static const float hyllian_SCANLINES      = 0.72;
static const float hyllian_SHARPER        = 0.0;

// GLSL mod(): x - y * floor(x / y)
float hyllian_mod(float x, float y) { return x - y * floor(x / y); }

vec3 hyllian_GAMMA_IN(vec3 color)  { return pow(color, vec3(hyllian_InputGamma, hyllian_InputGamma, hyllian_InputGamma)); }
vec3 hyllian_GAMMA_OUT(vec3 color) { return pow(color, vec3(1.0 / hyllian_OutputGamma, 1.0 / hyllian_OutputGamma, 1.0 / hyllian_OutputGamma)); }

vec3 crt_hyllian(CrtIn c)
{
    // vertex shader
    vec2 tex_size = vec2(c.SourceSize.x, c.SourceSize.y);
    vec2 ps = 1.0 / tex_size;
    vec2 vTexCoord = c.uv + ps * vec2(-0.49999, 0.0);

    vec2 dx = vec2(ps.x, 0.0);
    vec2 dy = vec2(0.0, ps.y);

    vec2 tc = (floor(vTexCoord.xy * c.SourceSize.xy) + vec2(0.49999, 0.49999)) / c.SourceSize.xy;

    vec2 fp = fract(vTexCoord.xy * c.SourceSize.xy);

    vec3 c10 = crt_tex_nearest(tc -       dx).xyz;
    vec3 c11 = crt_tex_nearest(tc           ).xyz;
    vec3 c12 = crt_tex_nearest(tc +       dx).xyz;
    vec3 c13 = crt_tex_nearest(tc + 2.0 * dx).xyz;

    vec4 lobes = vec4(fp.x * fp.x * fp.x, fp.x * fp.x, fp.x, 1.0);

    vec4 InvX = vec4(0.0);

    if (hyllian_SHARPER == 0.0) {
        // Horizontal cubic filter - "Catrom"
        InvX.x = dot(vec4(-0.5,  1.0, -0.5, 0.0), lobes);
        InvX.y = dot(vec4( 1.5, -2.5,  0.0, 1.0), lobes);
        InvX.z = dot(vec4(-1.5,  2.0,  0.5, 0.0), lobes);
        InvX.w = dot(vec4( 0.5, -0.5,  0.0, 0.0), lobes);
    }
    else if (hyllian_SHARPER == 1.0) {
        // Switch to "Hermite" - Sharper, smoothed bilinear
        InvX.x = dot(vec4( 0.0,  0.0,  0.0, 0.0), lobes);
        InvX.y = dot(vec4( 2.0, -3.0,  0.0, 1.0), lobes);
        InvX.z = dot(vec4(-2.0,  3.0,  0.0, 0.0), lobes);
        InvX.w = dot(vec4( 0.0,  0.0,  0.0, 0.0), lobes);
    }

    vec3 color = InvX.x * c10.xyz;
    color += InvX.y * c11.xyz;
    color += InvX.z * c12.xyz;
    color += InvX.w * c13.xyz;

    color = hyllian_GAMMA_IN(color);

    float pos1 = 1.5 - hyllian_SCANLINES - abs(fp.y - 0.5);
    float d1 = max(0.0, min(1.0, pos1));
    float d = d1 * d1 * (3.0 + hyllian_BRIGHTBOOST - (2.0 * d1));

    color = color * d;

    // dotmask
    float mod_factor = vTexCoord.x * c.OutputSize.x;
    vec4 dotMaskWeights = mix(
        vec4(1.0, 1.0 - hyllian_MASK_INTENSITY, 1.0, 1.0),
        vec4(1.0 - hyllian_MASK_INTENSITY, 1.0, 1.0 - hyllian_MASK_INTENSITY, 1.0),
        floor(hyllian_mod(mod_factor, 2.0)));
    color *= vec3(dotMaskWeights.x, dotMaskWeights.y, dotMaskWeights.z);

    color = hyllian_GAMMA_OUT(color);
    return vec3(color.r, color.g, color.b);
}
