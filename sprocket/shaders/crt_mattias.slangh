// Port of libretro slang-shaders crt/shaders/crt-mattias.slang (preset
// crt/crt-mattias.slangp: one pass, filter_linear0 = false, so the frame is
// point-sampled), default parameters.
//
// Original header:
// CRT Emulation
// by Mattias
// https://www.shadertoy.com/view/lsB3DV
//
// (No license is stated in the original; Shadertoy's default terms are CC BY-NC-SA 3.0.)
//
// Port notes: the original's macros are reproduced as locals: iChannel0 = the frame,
// iTime = float(FrameCount) / 60.0, iResolution = OutputSize.xy, and
// fragCoord = vTexCoord.xy * OutputSize.xy (not gl_FragCoord).
#pragma once
#include "crt_common.slangh"

// #pragma parameter defaults.
static const float mattias_CURVATURE = 0.5;
static const float mattias_SCANSPEED = 1.0;

vec3 mattias_sample_( vec2 tc )
{
	vec3 s = pow(crt_tex_nearest(tc).rgb, vec3(2.2));
	return s;
}

vec3 mattias_blur(vec2 tc, float offs, vec2 iResolution)
{
	vec4 xoffs = offs * vec4(-2.0, -1.0, 1.0, 2.0) / iResolution.x;
	vec4 yoffs = offs * vec4(-2.0, -1.0, 1.0, 2.0) / iResolution.y;

	vec3 color = vec3(0.0, 0.0, 0.0);
	color += mattias_sample_(tc + vec2(xoffs.x, yoffs.x)) * 0.00366;
	color += mattias_sample_(tc + vec2(xoffs.y, yoffs.x)) * 0.01465;
	color += mattias_sample_(tc + vec2(    0.0, yoffs.x)) * 0.02564;
	color += mattias_sample_(tc + vec2(xoffs.z, yoffs.x)) * 0.01465;
	color += mattias_sample_(tc + vec2(xoffs.w, yoffs.x)) * 0.00366;

	color += mattias_sample_(tc + vec2(xoffs.x, yoffs.y)) * 0.01465;
	color += mattias_sample_(tc + vec2(xoffs.y, yoffs.y)) * 0.05861;
	color += mattias_sample_(tc + vec2(    0.0, yoffs.y)) * 0.09524;
	color += mattias_sample_(tc + vec2(xoffs.z, yoffs.y)) * 0.05861;
	color += mattias_sample_(tc + vec2(xoffs.w, yoffs.y)) * 0.01465;

	color += mattias_sample_(tc + vec2(xoffs.x, 0.0)) * 0.02564;
	color += mattias_sample_(tc + vec2(xoffs.y, 0.0)) * 0.09524;
	color += mattias_sample_(tc + vec2(    0.0, 0.0)) * 0.15018;
	color += mattias_sample_(tc + vec2(xoffs.z, 0.0)) * 0.09524;
	color += mattias_sample_(tc + vec2(xoffs.w, 0.0)) * 0.02564;

	color += mattias_sample_(tc + vec2(xoffs.x, yoffs.z)) * 0.01465;
	color += mattias_sample_(tc + vec2(xoffs.y, yoffs.z)) * 0.05861;
	color += mattias_sample_(tc + vec2(    0.0, yoffs.z)) * 0.09524;
	color += mattias_sample_(tc + vec2(xoffs.z, yoffs.z)) * 0.05861;
	color += mattias_sample_(tc + vec2(xoffs.w, yoffs.z)) * 0.01465;

	color += mattias_sample_(tc + vec2(xoffs.x, yoffs.w)) * 0.00366;
	color += mattias_sample_(tc + vec2(xoffs.y, yoffs.w)) * 0.01465;
	color += mattias_sample_(tc + vec2(    0.0, yoffs.w)) * 0.02564;
	color += mattias_sample_(tc + vec2(xoffs.z, yoffs.w)) * 0.01465;
	color += mattias_sample_(tc + vec2(xoffs.w, yoffs.w)) * 0.00366;

	return color;
}

//Canonical noise function; replaced to prevent precision errors
//float rand(vec2 co){
//    return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453);
//}

float mattias_rand(vec2 co)
{
    float a = 12.9898;
    float b = 78.233;
    float c = 43758.5453;
    float dt= dot(co.xy ,vec2(a,b));
    float sn= mod(dt,3.14);
    return fract(sin(sn) * c);
}

vec2 mattias_curve(vec2 uv)
{
	uv = (uv - 0.5) * 2.0;
	uv *= 1.1;
	uv.x *= 1.0 + pow((abs(uv.y) / 5.0), 2.0);
	uv.y *= 1.0 + pow((abs(uv.x) / 4.0), 2.0);
	uv  = (uv / 2.0) + 0.5;
	uv =  uv *0.92 + 0.04;
	return uv;
}

vec3 crt_mattias(CrtIn c)
{
    vec2 vTexCoord = c.uv;
    float iTime = (float(c.FrameCount) / 60.0);
    vec2 iResolution = c.OutputSize.xy;
    vec2 fragCoord = (vTexCoord.xy * c.OutputSize.xy);

    vec2 q = fragCoord.xy / iResolution.xy;
    vec2 uv = q;
    uv = mix( uv, mattias_curve( uv ), mattias_CURVATURE );
    vec3 oricol = crt_tex_nearest( vec2(q.x,q.y) ).xyz;   // unused, as in the original
    vec3 col;
	float x =  sin(0.1*iTime+uv.y*21.0)*sin(0.23*iTime+uv.y*29.0)*sin(0.3+0.11*iTime+uv.y*31.0)*0.0017;
	float o =2.0*mod(fragCoord.y,2.0)/iResolution.x;
	x+=o;
    col.r = 1.0*mattias_blur(vec2(uv.x+0.0009,uv.y+0.0009),1.2,iResolution).x+0.005;
    col.g = 1.0*mattias_blur(vec2(uv.x+0.000,uv.y-0.0015),1.2,iResolution).y+0.005;
    col.b = 1.0*mattias_blur(vec2(uv.x-0.0015,uv.y+0.000),1.2,iResolution).z+0.005;
    col.r += 0.2*mattias_blur(vec2(uv.x+0.0009,uv.y+0.0009),2.25,iResolution).x-0.005;
    col.g += 0.2*mattias_blur(vec2(uv.x+0.000,uv.y-0.0015),1.75,iResolution).y-0.005;
    col.b += 0.2*mattias_blur(vec2(uv.x-0.0015,uv.y+0.000),1.25,iResolution).z-0.005;
    float ghs = 0.05;
	col.r += ghs*(1.0-0.299)*mattias_blur(0.75*vec2(0.01, -0.027)+vec2(uv.x+0.001,uv.y+0.001),7.0,iResolution).x;
    col.g += ghs*(1.0-0.587)*mattias_blur(0.75*vec2(-0.022, -0.02)+vec2(uv.x+0.000,uv.y-0.002),5.0,iResolution).y;
    col.b += ghs*(1.0-0.114)*mattias_blur(0.75*vec2(-0.02, -0.0)+vec2(uv.x-0.002,uv.y+0.000),3.0,iResolution).z;

    col = clamp(col*0.4+0.6*col*col*1.0,0.0,1.0);

    float vig = (0.0 + 1.0*16.0*uv.x*uv.y*(1.0-uv.x)*(1.0-uv.y));
	vig = pow(vig,0.3);
	col *= vec3(vig);

    col *= vec3(0.95,1.05,0.95);
	col = mix( col, col * col, 0.3) * 3.8;

	float scans = clamp( 0.35+0.15*sin(3.5*(iTime * mattias_SCANSPEED)+uv.y*iResolution.y*1.5), 0.0, 1.0);

	float s = pow(scans,0.9);
	col = col*vec3( s) ;

    col *= 1.0+0.0015*sin(300.0*iTime);

	col*=1.0-0.15*vec3(clamp((mod(fragCoord.x+o, 2.0)-1.0)*2.0,0.0,1.0));
	col *= vec3( 1.0 ) - 0.25*vec3( mattias_rand( uv+0.0001*iTime),  mattias_rand( uv+0.0001*iTime + 0.3 ),  mattias_rand( uv+0.0001*iTime+ 0.5 )  );
	col = pow(col, vec3(0.45));

	if (uv.x < 0.0 || uv.x > 1.0)
		col *= 0.0;
	if (uv.y < 0.0 || uv.y > 1.0)
		col *= 0.0;

    // (The original also computes an unused `comp = smoothstep(0.1, 0.9, sin(iTime))`.)

    return col;
}
